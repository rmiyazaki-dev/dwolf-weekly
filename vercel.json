{
  "routes": [
    { "src": "/(?:lib|dev|tests|docs|artifacts|\\.claude)(?:/.*)?", "status": 404, "dest": "/404.html" },
    { "src": "/.*\\.(?:sql|md)$", "status": 404, "dest": "/404.html" },
    { "src": "/\\.env(?:\\..*)?", "status": 404, "dest": "/404.html" },
    { "handle": "filesystem" }
  ],
  "crons": [
    {
      "path": "/api/daily",
      "schedule": "0 21 * * *"
    }
  ]
}
